{
  "mode": "unified-assistant",
  "classifierEnabled": false,
  "assistant": {
    "endpoint": "http://127.0.0.1:5000/api/assistant",
    "timeoutMs": 240000
  },
  "compatibility": {
    "endpoint": "/api/agent",
    "taskTypes": [
      "chat",
      "reasoning",
      "code",
      "rag",
      "tool"
    ],
    "response": "{ taskInfo, result: ApiResponse<AssistantResult> }"
  }
}
